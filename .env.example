# GEMINI_API_KEY: Required for Gemini AI API calls (OCR CNI/Permis, Smart Assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE Configuration for TAK TAK TAXI (Database & Auth)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# TWILIO Configuration (Real SMS OTP & SOS Emergency Alerts)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+18005550199"

# OPENROUTESERVICE / OSRM API Key (Optional for high-volume routing)
VITE_OPENROUTESERVICE_API_KEY="your_openrouteservice_key"

# LOCATIONIQ / NOMINATIM API Key (Optional for high-volume geocoding)
VITE_LOCATIONIQ_API_KEY="your_locationiq_key"
